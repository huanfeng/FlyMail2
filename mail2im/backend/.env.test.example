# 真实邮箱测试配置
# 复制此文件为 .env.test 并填入真实的邮箱信息
# 注意：.env.test 已在 .gitignore 中，不会被提交

# 测试邮箱账号 1 (Gmail)
TEST_EMAIL_1=user1@gmail.com
TEST_PASSWORD_1=your-app-password-here
TEST_IMAP_SERVER_1=imap.gmail.com
TEST_IMAP_PORT_1=993
TEST_SSL_MODE_1=ssl

# 测试邮箱账号 2 (Outlook)
TEST_EMAIL_2=user2@outlook.com
TEST_PASSWORD_2=your-password-here
TEST_IMAP_SERVER_2=outlook.office365.com
TEST_IMAP_PORT_2=993
TEST_SSL_MODE_2=ssl

# 测试邮箱账号 3 (163)
TEST_EMAIL_3=user3@163.com
TEST_PASSWORD_3=your-password-here
TEST_IMAP_SERVER_3=imap.163.com
TEST_IMAP_PORT_3=993
TEST_SSL_MODE_3=ssl

# 测试邮箱账号 4 (QQ)
TEST_EMAIL_4=user4@qq.com
TEST_PASSWORD_4=your-password-here
TEST_IMAP_SERVER_4=imap.qq.com
TEST_IMAP_PORT_4=993
TEST_SSL_MODE_4=ssl

# 代理配置（可选）
TEST_PROXY_TYPE=
TEST_PROXY_HOST=
TEST_PROXY_PORT=
TEST_PROXY_USERNAME=
TEST_PROXY_PASSWORD=
