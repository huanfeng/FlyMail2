# FlyMail 部署配置模板
#
#   cp .env.example .env
# 然后至少填好下面三项标了「必填」的值。.env 已被 .gitignore 排除，不会入库。

# ── 必填：JWT 签名密钥 ────────────────────────────────────────
# 生成：openssl rand -hex 32
# 变更此值会让所有已登录会话立即失效（需要重新登录）。
FLYMAIL_AUTH_JWT_SECRET=

# ── 必填：账户凭证加密密钥 ────────────────────────────────────
# 生成：openssl rand -hex 32
# 用于加密存储的邮箱密码。一旦有账户存入就不可再变更，
# 否则已保存的账户凭证将无法解密，只能删除账户重新添加。
FLYMAIL_CRYPTO_ENCRYPTION_KEY=

# ── 必填：首次启动创建的管理员密码 ────────────────────────────
# 仅在数据库不存在时生效；之后改密码请在 Web 界面操作，或用
#   docker compose exec flymail flymail db reset-admin-password --admin-pass 新密码
FLYMAIL_ADMIN_USER=admin
FLYMAIL_ADMIN_PASS=

# ── 网络 ────────────────────────────────────────────────────
# 宿主机监听地址与端口。8080 在本机已被占用，默认改用 8086。
# 若改为经反向代理暴露，把 FLYMAIL_BIND 设成 127.0.0.1。
FLYMAIL_BIND=0.0.0.0
FLYMAIL_PORT=8086

# ── 容器运行身份 ─────────────────────────────────────────────
# 设为宿主机当前用户的 uid/gid，使 ./data 下的文件可直接读写备份（id -u / id -g）。
PUID=1000
PGID=1000

# ── 其他 ────────────────────────────────────────────────────
TZ=Asia/Shanghai

# 日志级别：debug / info / warn / error
FLYMAIL_LOG_LEVEL=info
# 日志格式：json（便于检索）/ console（便于人读）
FLYMAIL_LOG_FORMAT=json

# 会话有效期
FLYMAIL_AUTH_ACCESS_TOKEN_TTL=15    # 访问令牌，分钟
FLYMAIL_AUTH_REFRESH_TOKEN_TTL=168  # 刷新令牌，小时
